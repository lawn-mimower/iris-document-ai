# Gemini (prototype1/agent.py, DAM/experiment_harness.py)
GEMINI_API_KEY="your_gemini_api_key_here"
# Optional: model overrides
# GEMINI_MODEL="gemini-2.5-flash"

# Neo4j (KG/inventory_management.py)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="your_neo4j_password_here"

# Optional DAM locations (defaults: the DAM/ folder)
# DAM_WORK_DIR="/path/to/dam_work"          # Milvus .db files, docling_outputs/, experiment_results/
# DAM_GROUND_TRUTH="/path/to/ground_truth.json"
# DAM_INPUT_DIR="/path/to/documents"        # reindex.py input folder
# DAM_REINDEX_OUTPUT="/path/to/reindex_output"
